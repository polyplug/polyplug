<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Assembly and namespace -->
    <AssemblyName>Polyplug.Host</AssemblyName>
    <RootNamespace>Polyplug.Host</RootNamespace>
    
    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Polyplug.Host</PackageId>
    <Version>0.1.2</Version>
    <Description>.NET host library for the polyplug plugin runtime. Native libraries for Linux, macOS, and Windows are embedded in the package.</Description>
    <PackageTags>polyplug;plugin;runtime;ffi;cross-platform</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\abi\Polyplug.Abi.csproj" />
  </ItemGroup>

  <!--
    Embed the native runtime libraries into the NuGet package. The release
    workflow populates runtimes/<rid>/native/ with the per-platform binaries
    before `dotnet pack`. PackagePath places them at the RID-conventional
    location so the .NET runtime resolves the correct binary per platform.
  -->
  <ItemGroup>
    <Content Include="runtimes\**\*" Pack="true" PackagePath="runtimes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>