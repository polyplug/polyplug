<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Polyplug.Loaders.Dotnet</AssemblyName>
    <RootNamespace>Polyplug.Loaders.Dotnet</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Polyplug.Loaders.Dotnet</PackageId>
    <Version>0.1.3</Version>
    <Description>Polyplug .NET loader for loading .NET-based plugins. Native libraries for Linux, macOS, and Windows are embedded.</Description>
    <PackageTags>polyplug;plugin;runtime;ffi;dotnet;net;loader</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\host\Polyplug.Host.csproj" />
    <ProjectReference Include="..\..\abi\Polyplug.Abi.csproj" />
  </ItemGroup>

  <!--
    Embed the per-platform loader native libraries into the NuGet package. The
    release workflow populates runtimes/<rid>/native/ before `dotnet pack`.
  -->
  <ItemGroup>
    <Content Include="runtimes\**\*" Pack="true" PackagePath="runtimes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>