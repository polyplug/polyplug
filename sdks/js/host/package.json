{
  "name": "@polyplug/host",
  "version": "0.1.3",
  "description": "polyplug host runtime for JavaScript/TypeScript (runs on Deno, Node.js, and Bun via a runtime-detected FFI seam)",
  "type": "module",
  "main": "./dist/mod.js",
