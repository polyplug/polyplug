  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "polyplug-src": "./mod.js",
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    }
  },
  "files": ["dist", "README.md"],
  "keywords": ["polyplug", "plugin", "host", "runtime", "ffi", "deno", "node", "bun"],
  "author": "polyplug",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/polyplug/polyplug.git", "directory": "sdks/js/host" },
  "dependencies": { "@polyplug/abi": "0.1.3" }
}
