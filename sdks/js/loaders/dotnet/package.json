{
  "name": "@polyplug/loaders-dotnet",
  "version": "0.1.2",
  "description": "polyplug .NET/C# bundle loader for JavaScript/TypeScript hosts (Deno runtime required; Node FFI backend planned)",
  "type": "module",
  "main": "./dist/mod.js",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "polyplug",
    "plugin",
    "loader",
    "dotnet",
    "deno"
  ],
  "author": "polyplug",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyplug/polyplug.git",
    "directory": "sdks/js/loaders/dotnet"
  },
  "engines": {
    "deno": ">=1.38.0"
  },
  "dependencies": {
    "@polyplug/host": "0.1.2"
  }
}
