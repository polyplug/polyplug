{
  "name": "@polyplug/sdk",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK for the polyplug plugin runtime (Deno runtime required; Node FFI backend planned)",
  "type": "module",
  "main": "./mod.ts",
  "types": "./mod.ts",
  "exports": {
    ".": {
      "types": "./mod.ts",
      "import": "./mod.ts"
    },
    "./abi": {
      "types": "./abi/polyplug_abi.ts",
      "import": "./abi/polyplug_abi.ts"
    },
    "./host": {
      "import": "./host/mod.js"
    },
    "./guest": {
      "import": "./guest/polyplug_guest.js"
    }
  },
  "files": [
    "**/*.ts",
    "**/*.js",
    "deno.json",
    "host/polyplug/_native/**"
  ],
  "keywords": [
    "polyplug",
    "plugin",
    "ffi",
    "runtime",
    "deno"
  ],
  "author": "polyplug",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyplug/polyplug.git",
    "directory": "sdks/js"
  },
  "engines": {
    "deno": ">=1.38.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}