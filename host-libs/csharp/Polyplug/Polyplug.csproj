<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Polyplug</AssemblyName>
    <RootNamespace>Polyplug</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <!-- NuGet package metadata -->
    <PackageId>Polyplug</PackageId>
    <Version>0.1.0</Version>
    <Authors>polyplug</Authors>
    <Description>.NET host library for the polyplug plugin runtime</Description>
    <PackageTags>polyplug;plugin;runtime;ffi</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/polyplug/polyplug</PackageProjectUrl>
    <RepositoryUrl>https://github.com/polyplug/polyplug.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed README in NuGet package -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <!-- Embed native libraries in NuGet package (runtimes folder convention) -->
    <!-- .NET automatically loads the correct native library based on RuntimeIdentifier -->
    <Content Include="runtimes\**\*.*">
      <Pack>true</Pack>
      <PackagePath>runtimes</PackagePath>
    </Content>
  </ItemGroup>

  <!-- Download native libraries from GitHub Releases before packing -->
  <Target Name="DownloadNativeLibraries" BeforeTargets="Pack">
    <Exec Command="pwsh -File download-native.ps1 -Version $(Version)" Condition="'$(OS)' == 'Windows_NT'" />
    <Exec Command="bash download-native.sh $(Version)" Condition="'$(OS)' != 'Windows_NT'" />
  </Target>
</Project>
