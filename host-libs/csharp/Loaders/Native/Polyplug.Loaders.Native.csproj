<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Polyplug.Loaders.Native</AssemblyName>
    <RootNamespace>Polyplug.Loaders</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <Description>Polyplug native library loader for loading native (C ABI) plugins</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Polyplug/Polyplug.csproj" />
  </ItemGroup>
</Project>